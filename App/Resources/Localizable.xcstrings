    "paywall.feature.local": {
      "comment": "Paywall feature bullet about on-device privacy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% on-device. Your files never leave your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % en el dispositivo. Tus archivos nunca salen de tu teléfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % auf dem Gerät. Deine Dateien verlassen nie dein iPhone."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % laitteella. Tiedostosi eivät koskaan poistu puhelimestasi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % på enheten. Dina filer lämnar aldrig din telefon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "100 % sur l’appareil. Vos fichiers ne quittent jamais votre téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "100% sul dispositivo. I tuoi file non lasciano mai il telefono."
          }
        }
      }
    },
