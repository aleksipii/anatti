    "paywall.renewal": {
      "comment": "Subscription renewal disclosure under the CTA.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews monthly until cancelled. Cancel anytime in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva cada mes hasta que se cancele. Cancela cuando quieras en Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich monatlich bis zur Kündigung. Jederzeit in den Einstellungen kündbar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusiutuu kuukausittain, kunnes peruutat. Peruuta milloin tahansa Asetuksissa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förnyas varje månad tills du avbryter. Avsluta när som helst i Inställningar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renouvelle chaque mois jusqu’à résiliation. Résiliable à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova ogni mese fino alla disdetta. Annulla in qualsiasi momento da Impostazioni."
          }
        }
      }
    },
