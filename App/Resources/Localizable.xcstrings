    "projects.empty.message": {
      "comment": "Empty state message explaining how to start.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a project to generate store screenshots and videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un proyecto para generar capturas y vídeos para las tiendas."
